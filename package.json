{
  "name": "bipolar-win",
  "productName": "Bipolar",
  "version": "0.1.0",
  "description": "Bipolar for Windows: terminal workspace with separate Office and Personal sections",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "postinstall": "node -e \"if(process.platform==='darwin')for(const a of ['arm64','x64'])try{require('fs').chmodSync('node_modules/node-pty/prebuilds/darwin-'+a+'/spawn-helper',0o755)}catch{}\"",
    "build": "electron-packager . Bipolar --platform=win32 --arch=x64 --overwrite --out=dist --icon=build/icon.ico --no-asar --win32metadata.CompanyName=Bipolar --win32metadata.FileDescription=Bipolar --win32metadata.ProductName=Bipolar --ignore=^/dist --ignore=^/\\.git --ignore=prebuilds/darwin- --ignore=prebuilds/win32-arm64 --ignore=\\.pdb$ --ignore=node_modules/@mediapipe --ignore=^/test --ignore=^/\\.github",
    "test": "node test/e2e-win.js",
    "package": "npm run build && cd dist && rm -rf Bipolar Bipolar-Windows-x64.zip && cp -R Bipolar-win32-x64 Bipolar && ditto -c -k --keepParent Bipolar Bipolar-Windows-x64.zip && rm -rf Bipolar"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@electron/rebuild": "^4.2.0",
    "electron": "^44.5.1"
  }
}
